---
import Base from "../layouts/Base.astro";
import { getHighCouncil } from "../lib/data";

const councilors = getHighCouncil();
---

<Base title="High Council" description="High council ward assignments and stewardships.">
  <h1>High council</h1>
  <p class="lede">Ward assignments and stewardships for each high councilor.</p>
  {
    councilors.length === 0 ? (
      <p class="empty">High council assignments haven't been posted yet.</p>
    ) : (
      <div class="grid">
        {councilors.map((c) => (
          <article class="card">
            <h3>{c.name}</h3>
            {c.wards.length > 0 && (
              <>
                <p class="muted" style="margin:0;font-size:.85rem">Wards</p>
                <ul class="tags">{c.wards.map((w) => <li>{w}</li>)}</ul>
              </>
            )}
            {c.stewardships.length > 0 && (
              <>
                <p class="muted" style="margin:12px 0 0;font-size:.85rem">Stewardships</p>
                <ul style="margin:4px 0 0;padding-left:20px">{c.stewardships.map((s) => <li>{s}</li>)}</ul>
              </>
            )}
            {c.notes && <p class="muted" style="margin:10px 0 0">{c.notes}</p>}
          </article>
        ))}
      </div>
    )
  }
</Base>
