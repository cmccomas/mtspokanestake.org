---
import Base from "../layouts/Base.astro";
import { getHighCouncil } from "../lib/data";

const councilors = getHighCouncil();
---

<Base title="High Council" description="High council ward assignments and stewardships.">
  <div class="page-head">
    <h1>High council</h1>
    <p class="lede">Ward assignments and stewardships for each high councilor.</p>
  </div>
  {
    councilors.length === 0 ? (
      <p class="empty">High council assignments haven't been posted yet.</p>
    ) : (
      <div class="grid">
        {councilors.map((c) => (
          <article class="panel">
            <h3>{c.name}</h3>
            {c.wards.length > 0 && (
              <>
                <p class="label">Wards</p>
                <ul class="tags">
                  {c.wards.map((w) => (
                    <li>{w}</li>
                  ))}
                </ul>
              </>
            )}
            {c.stewardships.length > 0 && (
              <>
                <p class="label">Stewardships</p>
                <ul class="plain">
                  {c.stewardships.map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </>
            )}
            {c.notes && <p class="muted" style="margin:12px 0 0">{c.notes}</p>}
          </article>
        ))}
      </div>
    )
  }
</Base>

<style>
  .label {
    color: var(--muted);
    font-size: 0.85rem;
    margin: 14px 0 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tags li {
    background: var(--accent-soft);
    color: var(--accent-ink);
    border-radius: 999px;
    padding: 3px 11px;
    font-size: 0.88rem;
  }
  .plain {
    margin: 0;
    padding-left: 18px;
  }
</style>
