---
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import { getConferences } from "../lib/data";
import { formatLong, formatRange } from "../lib/dates";

const conferences = getConferences();
---

<Base title="Stake Conference" description="Stake conference sessions and assignments.">
  <div class="page-head">
    <h1>Stake conference</h1>
    <p class="lede">Sessions, speakers, prayers and music assignments.</p>
  </div>
  <Timeline
    count={conferences.length}
    empty="The next stake conference hasn't been posted yet. Check back closer to the date."
    pastLabel="Past conferences"
    list="stack-lg"
  >
    {
      conferences.map((c) => (
        <article data-date={c.date} data-end={c.endDate}>
          <p class="date-label">{formatRange(c.date, c.endDate)}</p>
          <h2>{c.name}</h2>
          {c.theme && <p class="lede" style="margin-top:6px"><em>{c.theme}</em></p>}
          {c.location && <p class="muted" style="margin:4px 0 0">{c.location}</p>}
          {c.notes && <p>{c.notes}</p>}
          <div class="stack" style="margin-top:24px">
            {c.sessions.map((s) => (
              <section class="panel">
                <h3>{s.name}</h3>
                <p class="muted" style="margin:2px 0 12px">
                  {[s.date && formatLong(s.date), s.time, s.location].filter(Boolean).join(" · ")}
                </p>
                {s.assignments.length > 0 ? (
                  <dl class="rows assignments">
                    {s.assignments.map((a) => (
                      <div>
                        <dt class="term">{a.role}</dt>
                        <dd class="detail">{a.name}</dd>
                      </div>
                    ))}
                  </dl>
                ) : (
                  <p class="empty">Assignments to come.</p>
                )}
              </section>
            ))}
          </div>
        </article>
      ))
    }
  </Timeline>
</Base>

<style>
  .assignments {
    margin: 0;
  }
  .assignments > div {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 4px 20px;
    padding: 11px 0;
    border-bottom: 1px solid var(--line);
  }
  .assignments > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .assignments dd {
    margin: 0;
  }
  @media (max-width: 520px) {
    .assignments > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
