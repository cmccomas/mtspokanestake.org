---
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import { getEvents } from "../lib/data";
import { chipParts, formatLong } from "../lib/dates";

// Ward conferences come from the calendar (events.yaml): any event whose title
// ends in "Conference" and names a ward (contains "Ward" or "YSA").
const conferences = getEvents().filter(
  (e) => /conference$/i.test(e.title) && /\b(ward|ysa)\b/i.test(e.title),
);
---

<Base title="Ward Conferences" description="Ward conference schedule for each ward in the stake.">
  <div class="page-head">
    <h1>Ward conferences</h1>
    <p class="lede">
      The stake presidency and stake council attend each ward conference. A ward has no stake
      speaker in the month of its ward conference.
    </p>
  </div>
  <Timeline
    count={conferences.length}
    empty="No upcoming ward conferences posted yet."
    showPast={false}
    list="dated"
    asList
  >
    {
      conferences.map((e) => {
        const chip = chipParts(e.date);
        return (
          <li data-date={e.date} data-end={e.endDate}>
            <span class="chip" aria-hidden="true">
              <span class="chip-month">{chip.month}</span>
              <span class="chip-day">{chip.day}</span>
            </span>
            <div class="body">
              <h3>{e.title.replace(/ Conference$/i, "")}</h3>
              <p class="sub">{formatLong(e.date)}{e.time && ` · ${e.time}`}</p>
                {e.location && <p class="sub">{e.location}</p>}
            </div>
          </li>
        );
      })
    }
  </Timeline>
</Base>
