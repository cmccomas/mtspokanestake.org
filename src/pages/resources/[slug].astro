---
import Base from "../../layouts/Base.astro";
import { getTables, type Table } from "../../lib/data";

export function getStaticPaths() {
  return getTables().map((table) => ({ params: { slug: table.slug }, props: { table } }));
}

const { table } = Astro.props as { table: Table };
---

<Base title={table.title} description={table.description}>
  <p><a href="/resources">← Resources</a></p>
  <h1>{table.title}</h1>
  {table.description && <p class="lede">{table.description}</p>}
  {
    table.rows.length === 0 ? (
      <p class="empty">Nothing listed yet.</p>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>{table.columns.map((c) => <th>{c}</th>)}</tr>
          </thead>
          <tbody>
            {table.rows.map((row) => (
              <tr>{row.map((cell) => <td>{cell ?? ""}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Base>
