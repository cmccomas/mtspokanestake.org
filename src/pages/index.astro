---
import Base from "../layouts/Base.astro";
import Timeline from "../components/Timeline.astro";
import { getSite, getEvents, getSpeaking, getConferences, getWards } from "../lib/data";
import { chipParts, formatLong, formatRange, groupByDate } from "../lib/dates";

const site = getSite();
const events = getEvents();
const speakingSundays = groupByDate(getSpeaking());
const conferences = getConferences();
const wards = getWards();
---

<Base>
  <div class="page-head">
    <h1>Welcome to the {site.name}</h1>
    {site.tagline && <p class="lede">{site.tagline}</p>}
    <ul class="pills">
      <li><a href="/speaking">Speaking assignments</a></li>
      <li><a href="/ward-conferences">Ward conferences</a></li>
      <li>
        <a href="https://calendar.churchofjesuschrist.org" target="_blank" rel="noopener">
          Church calendar
          <svg class="ext" viewBox="0 0 16 16" aria-label="(opens in a new tab)">
            <path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </a>
      </li>
    </ul>
  </div>

  <div class="stack">
    {site.announcement && <div class="announcement">{site.announcement}</div>}
    <Timeline count={1} empty="" showPast={false}>
      <a class="callout" data-date="2026-11-29" href="/ysa">
        <strong>Spokane River YSA Ward:</strong> your stake presidency would love to get to know you
        before ward conference on Sunday, November 29.{" "}
        <span class="go">Share a little about yourself →</span>
      </a>
    </Timeline>
  </div>

  <section class="section" aria-labelledby="speakers-heading">
    <div class="section-head">
      <h2 id="speakers-heading">Next speaking Sunday</h2>
      <a href="/speaking">All Sundays →</a>
    </div>
    <Timeline
      count={speakingSundays.length}
      empty="No speaking assignments posted yet."
      limit={1}
      showPast={false}
    >
      {
        speakingSundays.map((g) => (
          <div data-date={g.date}>
            <p class="date-label">{formatLong(g.date)}</p>
            <ul class="rows">
              {g.items.map((a) => (
                <li>
                  <span class="term">{a.ward}</span>
                  <span class="detail">
                    {a.speakers.length > 0 ? a.speakers.join(", ") : <em class="muted">{a.notes}</em>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </Timeline>
  </section>

  <section class="section" aria-labelledby="coming-heading">
    <div class="section-head">
      <h2 id="coming-heading">Coming up</h2>
      <a href="https://calendar.churchofjesuschrist.org" target="_blank" rel="noopener">Full calendar →</a>
    </div>
    <Timeline
      count={events.length}
      empty="Nothing posted here yet. See the Church calendar for stake and ward events."
      limit={4}
      showPast={false}
      list="dated"
      asList
    >
      {
        events.map((e) => {
          const chip = chipParts(e.date);
          return (
            <li data-date={e.date} data-end={e.endDate}>
              <span class="chip" aria-hidden="true">
                <span class="chip-month">{chip.month}</span>
                <span class="chip-day">{chip.day}</span>
              </span>
              <div class="body">
                <h3>{e.title}</h3>
                <p class="sub">{formatRange(e.date, e.endDate)}{e.time && ` · ${e.time}`}</p>
                {e.location && <p class="sub">{e.location}</p>}
              </div>
            </li>
          );
        })
      }
    </Timeline>
  </section>

  {
    conferences.length > 0 && (
      <section class="section" aria-labelledby="stake-conf-heading">
        <div class="section-head">
          <h2 id="stake-conf-heading">Stake conference</h2>
          <a href="/stake-conference">Sessions →</a>
        </div>
        <Timeline
          count={conferences.length}
          empty="The next stake conference hasn't been posted yet."
          limit={1}
          showPast={false}
        >
          {conferences.map((c) => (
            <div class="panel" data-date={c.date} data-end={c.endDate}>
              <p class="date-label">{formatRange(c.date, c.endDate)}</p>
              <h3>{c.name}</h3>
              {c.theme && <p class="muted" style="margin:4px 0 0">{c.theme}</p>}
            </div>
          ))}
        </Timeline>
      </section>
    )
  }

  {
    wards.length > 0 && (
      <section class="section" aria-labelledby="wards-heading">
        <div class="section-head">
          <h2 id="wards-heading">Wards</h2>
        </div>
        <ul class="rows">
          {wards.map((w) => (
            <li>
              <span class="detail">{w.name}</span>
              <span class="term">
                {[w.meetingTime, w.building].filter(Boolean).join(" · ")}
                {w.address && <span class="note">{w.address}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    site.stakeCenter?.address && (
      <section class="section" aria-labelledby="center-heading">
        <div class="section-head">
          <h2 id="center-heading">Stake center</h2>
        </div>
        <p style="margin:0">
          {site.stakeCenter.name && (
            <>
              {site.stakeCenter.name}
              <br />
            </>
          )}
          {site.stakeCenter.address}
        </p>
      </section>
    )
  }
</Base>
