---
// A dated list. Each direct child of the slot needs data-date (and optionally data-end).
// The script in Base.astro moves past children into the "Past" section in the browser.
interface Props {
  count: number;
  empty: string;
  pastLabel?: string;
  limit?: number;
  showPast?: boolean;
  // Layout class for the list: "stack" (spaced blocks), "dated" or "rows" (hairline lists).
  list?: string;
  // Use ul/li markup, for "dated" and "rows" lists.
  asList?: boolean;
}
const {
  count,
  empty,
  pastLabel = "Past",
  limit,
  showPast = true,
  list = "stack",
  asList = false,
} = Astro.props;
const Tag = asList ? "ul" : "div";
---

<section data-timeline data-limit={limit}>
  <Tag class={list} data-upcoming><slot /></Tag>
  {empty && <p class="empty" data-empty hidden={count > 0}>{empty}</p>}
  {
    showPast && (
      <details class="past" data-past hidden>
        <summary>{pastLabel}</summary>
        <Tag class={list} data-past-list />
      </details>
    )
  }
</section>
