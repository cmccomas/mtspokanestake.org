---
// A dated list. Each direct child of the slot needs data-date (and optionally data-end).
// The script in Base.astro moves past children into the "Past" section in the browser.
interface Props {
  count: number;
  empty: string;
  pastLabel?: string;
  limit?: number;
  showPast?: boolean;
}
const { count, empty, pastLabel = "Past", limit, showPast = true } = Astro.props;
---

<section data-timeline data-limit={limit}>
  <div class="stack" data-upcoming><slot /></div>
  <p class="empty" data-empty hidden={count > 0}>{empty}</p>
  {
    showPast && (
      <details class="past" data-past hidden>
        <summary>{pastLabel}</summary>
        <div class="stack" data-past-list />
      </details>
    )
  }
</section>
