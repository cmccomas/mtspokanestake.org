---
import { getSite, getTables } from "../lib/data";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const site = getSite();
const hasResources = getTables().length > 0;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "Home" },
  { href: "/speaking", label: "Speaking" },
  { href: "/ward-conferences", label: "Ward Conferences" },
  { href: "/stake-conference", label: "Stake Conference" },
  { href: "/high-council", label: "High Council" },
  ...(hasResources ? [{ href: "/resources", label: "Resources" }] : []),
  { href: "https://calendar.churchofjesuschrist.org", label: "Calendar" },
];
const isExternal = (href: string) => href.startsWith("http");
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const updated = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "America/Los_Angeles",
}).format(new Date());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description ?? site.tagline ?? site.name} />
    <meta name="theme-color" content="#1d4a33" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/" aria-label={`${site.name} home`}>
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M3 25 13 9l5 7.5L21.5 12 29 25Z" fill="currentColor" />
          </svg>
          <span>{site.name}</span>
        </a>
        <nav aria-label="Main" class="site-nav">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                    {...(isExternal(item.href) && { target: "_blank", rel: "noopener" })}
                  >
                    {item.label}
                    {isExternal(item.href) && (
                      <svg class="ext" viewBox="0 0 16 16" aria-label="(opens in a new tab)">
                        <path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.6" />
                      </svg>
                    )}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p class="footer-name">
          {site.name}{site.contactEmail && (
            <>
              {" · "}
              <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
            </>
          )}
        </p>
        <p>
          This is not an official website of The Church of Jesus Christ of Latter-day Saints. Find
          meetinghouses and service times at{" "}
          <a href="https://maps.churchofjesuschrist.org">maps.churchofjesuschrist.org</a>.
        </p>
        <p>Last updated {updated}</p>
      </div>
    </footer>

    <script>
      // Moves dated items that have passed into each timeline's "Past" section, using
      // today's date in Spokane. Runs in the browser so the site never needs a rebuild
      // just because a date went by. Without JavaScript everything simply stays listed.
      const today = new Intl.DateTimeFormat("en-CA", { timeZone: "America/Los_Angeles" }).format(
        new Date(),
      );
      for (const timeline of document.querySelectorAll<HTMLElement>("[data-timeline]")) {
        const upcoming = timeline.querySelector<HTMLElement>("[data-upcoming]");
        const pastList = timeline.querySelector<HTMLElement>("[data-past-list]");
        const past = timeline.querySelector<HTMLElement>("[data-past]");
        const empty = timeline.querySelector<HTMLElement>("[data-empty]");
        if (!upcoming) continue;
        for (const item of [...upcoming.querySelectorAll<HTMLElement>(":scope > [data-date]")]) {
          const end = item.dataset.end || item.dataset.date!;
          if (end < today) {
            if (pastList) pastList.prepend(item);
            else item.remove();
          }
        }
        const remaining = [...upcoming.querySelectorAll<HTMLElement>(":scope > [data-date]")];
        const limit = Number(timeline.dataset.limit || 0);
        if (limit) remaining.slice(limit).forEach((el) => el.remove());
        if (empty) empty.hidden = remaining.length > 0;
        if (past && pastList) past.hidden = pastList.children.length === 0;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f5f0;
    --surface: #ffffff;
    --ink: #1c2620;
    --muted: #59635c;
    --line: rgb(28 38 32 / 0.1);
    --line-strong: rgb(28 38 32 / 0.16);
    --accent: #1d4a33;
    --accent-ink: #163a28;
    --accent-soft: #e6eee8;
    --date: #7a5410;
    --callout: #f5edd6;
    --callout-line: rgb(122 84 16 / 0.2);
    --radius: 12px;
    --serif: "Newsreader", Georgia, serif;
    --sans: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 17px/1.55 var(--sans);
    -webkit-font-smoothing: antialiased;
  }
  @media (min-width: 900px) {
    body {
      font-size: 16px;
    }
  }
  a {
    color: var(--accent);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  a:hover {
    color: var(--accent-ink);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 8px;
    background: var(--surface);
    padding: 8px 12px;
    z-index: 10;
  }

  /* Header */
  .site-header {
    background: var(--accent);
    color: #fff;
  }
  /* Two rows at every width: name, then links. Seven links never fit beside the name. */
  .header-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding-top: 16px;
    padding-bottom: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    font: 600 1.25rem/1.2 var(--serif);
    flex-shrink: 0;
    user-select: none;
  }
  .brand:hover {
    color: #fff;
  }
  .brand-mark {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: #cfe0d4;
  }
  .site-nav {
    margin-left: -12px;
  }
  .site-nav ul {
    list-style: none;
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    display: flex;
    align-items: center;
    gap: 4px;
    min-height: 40px;
    color: rgb(255 255 255 / 0.82);
    text-decoration: none;
    font-size: 0.94rem;
    font-weight: 500;
    padding: 0 12px;
    border-radius: 999px;
    white-space: nowrap;
    user-select: none;
  }
  .site-nav a:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.08);
  }
  .site-nav a[aria-current="page"] {
    color: #fff;
    background: rgb(255 255 255 / 0.16);
  }
  .site-nav .ext {
    width: 11px;
    height: 11px;
    opacity: 0.75;
  }
  /* Phones and tablets: links move to their own row and scroll sideways. */
  @media (max-width: 899px) {
    .site-nav {
      width: calc(100% + 40px);
      margin: 0 -20px;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .site-nav::-webkit-scrollbar {
      display: none;
    }
    .site-nav ul {
      padding: 0 12px;
      width: max-content;
    }
  }

  /* Page structure */
  main.wrap {
    padding-top: 40px;
    padding-bottom: 72px;
    min-height: 60vh;
  }
  h1,
  h2,
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 2.6rem);
    letter-spacing: -0.015em;
    margin: 0 0 10px;
  }
  h2 {
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    margin: 0;
  }
  h3 {
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    margin: 0;
  }
  p {
    text-wrap: pretty;
  }
  .lede {
    color: var(--muted);
    font-size: 1.08rem;
    margin: 0;
    max-width: 60ch;
  }
  .page-head {
    margin-bottom: 36px;
  }
  .muted {
    color: var(--muted);
  }
  .nb {
    white-space: nowrap;
  }
  .section {
    margin-top: 48px;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }
  .section-head a {
    font-size: 0.94rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .stack {
    display: grid;
    gap: 12px;
  }
  .stack-lg {
    display: grid;
    gap: 40px;
  }
  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--date);
    margin: 0 0 8px;
  }
  .date-label {
    font-weight: 600;
    color: var(--date);
    font-size: 0.92rem;
    margin: 0 0 4px;
    font-variant-numeric: tabular-nums;
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
    font-family: var(--sans);
    font-weight: 400;
  }
  .empty {
    color: var(--muted);
    margin: 0;
    padding: 18px 0;
    border-top: 1px solid var(--line);
  }

  /* Panels: one surface level only */
  .panel {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
  }
  .panel > :last-child {
    margin-bottom: 0;
  }
  .callout {
    display: block;
    background: var(--callout);
    border: 1px solid var(--callout-line);
    border-radius: var(--radius);
    padding: 16px 20px;
    color: var(--ink);
    text-decoration: none;
  }
  .callout:hover {
    color: var(--ink);
    border-color: rgb(122 84 16 / 0.4);
  }
  .callout strong {
    font-weight: 600;
  }
  .callout .go {
    color: var(--accent);
    font-weight: 600;
    white-space: nowrap;
  }
  .announcement {
    background: var(--callout);
    border: 1px solid var(--callout-line);
    border-radius: var(--radius);
    padding: 16px 20px;
  }

  /* Quick links */
  .pills {
    display: flex;
    gap: 8px;
    margin: 24px -20px 0;
    padding: 0 20px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pills::-webkit-scrollbar {
    display: none;
  }
  .pills li {
    flex-shrink: 0;
  }
  .pills a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    user-select: none;
  }
  .pills a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .pills .ext {
    width: 11px;
    height: 11px;
    color: var(--muted);
  }

  /* Rows: hairline-divided lists */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rows > li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 4px 20px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }
  .rows .term {
    color: var(--muted);
  }
  .rows .detail {
    font-weight: 500;
  }
  .rows .note {
    display: block;
    color: var(--muted);
    font-weight: 400;
    font-size: 0.92rem;
    margin-top: 2px;
  }
  @media (max-width: 520px) {
    .rows > li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .rows .term {
      font-size: 0.92rem;
    }
  }

  /* Date chip rows (ward conferences, events) */
  .dated {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .dated > li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .chip {
    flex-shrink: 0;
    width: 56px;
    text-align: center;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 6px 0 7px;
    font-variant-numeric: tabular-nums;
    user-select: none;
  }
  .chip-month {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--date);
  }
  .chip-day {
    display: block;
    font: 500 1.5rem/1.1 var(--serif);
    color: var(--ink);
  }
  .dated .body {
    min-width: 0;
  }
  .dated .sub {
    color: var(--muted);
    font-size: 0.94rem;
    margin: 2px 0 0;
  }

  /* Tables (resources) sit on the page */
  .table-wrap {
    overflow-x: auto;
    margin: 0 -20px;
    padding: 0 20px;
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  th,
  td {
    text-align: left;
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.92rem;
    white-space: nowrap;
    border-bottom-color: var(--line-strong);
  }
  td:last-child,
  th:last-child {
    padding-right: 0;
  }

  /* Past items */
  details.past {
    margin-top: 32px;
  }
  details.past summary {
    cursor: pointer;
    color: var(--muted);
    font-weight: 500;
    min-height: 44px;
    display: flex;
    align-items: center;
    user-select: none;
  }
  details.past > div {
    margin-top: 12px;
    opacity: 0.75;
  }

  /* Footer */
  .site-footer {
    background: #efece4;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
    padding: 28px 0 36px;
  }
  .site-footer p {
    margin: 0 0 6px;
    max-width: 70ch;
  }
  .footer-name {
    color: var(--ink);
    font-weight: 600;
  }
</style>
